# Optional OpenRouter provider credential.
# Copy this file to $HOME/.config/grokky/.env or choose another local env file in Settings.
OPENROUTER_API_KEY=replace_with_your_key

# Pi uses its own saved credential store at $HOME/.pi/agent/auth.json and also
# recognizes provider environment variables such as ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY, and GOOGLE_API_KEY.
# PI_CODING_AGENT_DIR may point Pi at another private configuration directory.

# Remote MCP servers may reference a bearer token environment variable from
# their Codex configuration. Keep the value in the launching environment; only
# the variable name belongs in config. OAuth tokens use encrypted app storage.
